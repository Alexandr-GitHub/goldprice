<!DOCTYPE html>
<html lang="ru">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<title>[[+title]]</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
<tr>
<td align="center" style="padding:16px 0;">
<table width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;margin:0 auto;border-collapse:collapse;border:1px solid #E5E5E5;">
<tr>
<td style="padding:16px 20px;background:#fafafa;border-bottom:3px solid #dbc152;">
<img src="[[+logo_url]]" alt="[[+logo_alt]]" height="48" style="height:48px;display:block;border:0;outline:none;" />
</td>
</tr>
<tr>
<td style="padding:20px 20px 8px;font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:1.3;font-weight:bold;color:#111111;">
[[+title]]
</td>
</tr>
<tr>
<td style="padding:0 20px 24px;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
[[+rows]]
</table>
</td>
</tr>
<tr>
<td style="padding:12px 20px;background:#fafafa;border-top:1px solid #E5E5E5;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.4;color:#888888;">
[[+site_name]]
</td>
</tr>
</table>
</td>
</tr>
</table>
</body>
</html>
